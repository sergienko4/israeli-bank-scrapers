{
  // tsup's declaration build uses the TypeScript 6 API and bundler resolution;
  // the whole-tree checks retain NodeNext in tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "exclude": ["node_modules", "**/*.test.ts", "src/Tests/**/*", "jest.config.js"]
}
