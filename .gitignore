# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Typescript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# NPM package build output
lib/

# Claude Code (local only)
CLAUDE.md
.claude/

# IDEs
.idea
.vscode
.DS_Store
.beinleumi-otp.tmp
.onezero-otp.tmp
# TypeDoc output (regenerated via `npm run docs`; deployed to GH Pages /api/)
/typedoc-build/
# mkdocs build output (regenerated via `python -m mkdocs build`; deployed to GH Pages /)
/site/
/.mkdocs-strict-out/

# Local debug sessions, trace output, inspection scripts — never commit
# All local work lives in local-debug/ (debug captures + scripts)
local-debug/
.visacal-debug/

# Local-only reproduction harnesses (e.g. Amex slow-network login repro).
# Real-credential probes that must NEVER reach the PR or coverage gates.
src/Tests/**/*.local.test.ts

# Future bank scraper backlog (local research — not part of current PR)
capture/
tasks/

scripts/**
!scripts/audit-fixtures-pii.cjs
# Generates docs/compatibility.md from compatibility.json; CI runs it with
# --check, so it has to be in the tree for the docs gate to work.
!scripts/build-compatibility.mjs
# Enforced by the PR-body compliance workflow, so it must be in the tree.
!scripts/check-breaking-note.mjs
!scripts/check-staged-pii.cjs
# Published tooling: named in package.json "files", so it ships in the
# tarball and runs from postinstall on every consumer install.
!scripts/patch-playwright-core.mjs
!scripts/pii-denylist.sha256
!scripts/sweep-fixtures-pii.ts
# Run by the release workflow to append the Upgrading section to the
# GitHub release body.
!scripts/upgrade-notes.mjs
!scripts/validate-pr-body.mjs
# Committed tooling: the decoupling matrix required by post-pr-checklist C5.
# It previously lived in an ephemeral agent session folder, so it vanished
# between sessions and C5 was repeatedly skipped. Generated snapshots stay
# ignored except the committed baseline every future diff compares against,
# regenerated with:
#   node scripts/decoupling-metrics/measure.mjs . baseline baseline.json
!scripts/decoupling-metrics/
!scripts/decoupling-metrics/**
scripts/decoupling-metrics/snapshots/*
!scripts/decoupling-metrics/snapshots/baseline.json
# Committed tooling: peak-memory profiler used to size a scrape before a
# release. Captured run artifacts stay ignored — they are machine- and
# run-specific, and the scrape log can contain account-level PII.
!scripts/memory-profile/
!scripts/memory-profile/**
scripts/memory-profile/runs/

# Stale lint-output left by an older verify-script version. Current
# src/Scrapers/Pipeline/EslintCanaries/verify.sh writes to os.tmpdir(),
# so this in-repo path must never appear again.
.canary-verify-tmp.json

#Understand Anything local data (local research — not part of current PR)
.understand-anything
# Python bytecode (mkdocs hooks)
__pycache__/
*.pyc

.agent-*/*
.commit*

# Operator-specific PII literals consumed at runtime by
# scripts/audit-fixtures-pii.cjs and src/Tests/Integration/Tools/PiiRedactor.ts.
# Copy .pii-secrets.example.json → .pii-secrets.json and populate with REAL
# values for your environment. NEVER commit the real file — it contains
# operator name, account numbers, IDs, emails, etc. The example file with
# placeholder values IS committed so tests have a default to load from.
.pii-secrets.json
.pii-secrets.local.json

# Browser session state (live WAF clearance cookies) - never commit
*.session.json
