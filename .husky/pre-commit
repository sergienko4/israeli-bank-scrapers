#!/usr/bin/env bash
# Local pre-commit gates: fast, scoped to what is staged, plus the checks
# that stop a leak before it enters history. Every repo-wide gate (build,
# full ESLint, canaries, guardrails, guideline coverage, test duplication,
# Jest scopes, docs gates, audit) runs in CI on every pull request it can
# affect; HookGatesInCi.test.ts fails if a gate here has no CI step.
set -o pipefail
LOG_FILE=".pre-commit-output.log"
: > "$LOG_FILE"

# ── Skip for non-code changes ─────────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only)
CODE_FILES=$(echo "$STAGED_FILES" | grep -v -E '^\.(github|husky)/|^(README|CHANGELOG|CONTRIBUTING|SECURITY|CODE_OF_CONDUCT|CLEAN_CODE|LICENSE)' | grep -v -E '\.(md|json|yml|yaml)$' | grep -v -E '^(tasks/|\.)' || true)
if [ -z "$CODE_FILES" ]; then
    # Docs, workflows and config are where a planning ID is likeliest to
    # slip in, and every one of them arrives in this branch. The scan reads
    # only the staged additions, so it costs well under a second.
    if ! env BASE_SHA= npm run lint:plan-refs >>"$LOG_FILE" 2>&1; then
        echo "❌ plan-refs FAILED — an added line cites a local planning ID; see $LOG_FILE" | tee -a "$LOG_FILE"
        exit 1
    fi
    echo "  ✅ plan-refs passed" | tee -a "$LOG_FILE"
    echo "⏭️  No source code changes — skipping quality gates" | tee -a "$LOG_FILE"
    exit 0
fi

log() { echo "$1" | tee -a "$LOG_FILE"; }
FAIL_COUNT=0
FAIL_NAMES=""

# ── Cache infrastructure ──────────────────────────────────────────────
# Each gate's pass/fail is cached against the SHA of the staged tree.
# When the same content set has already passed a gate, skip it on the
# next commit. The cache key is `git write-tree`, computed AFTER Phase
# 1 prettier so whitespace fix-ups don't invalidate. Cache lives under
# `node_modules/.cache/pre-commit/` so it inherits `node_modules/`'s
# existing gitignore — no separate ignore entry needed.
CACHE_DIR="node_modules/.cache/pre-commit"
mkdir -p "$CACHE_DIR"

cache_marker() {
    # On Windows NTFS, `:` is the Alternate Data Stream separator, so
    # `touch foo:bar` writes to an ADS on `foo` and the subsequent
    # `[ -f foo:bar ]` returns false — the cache speed-up silently
    # disables for every Windows contributor. Replace `:` with `_`
    # for the filename component to keep the markers portable.
    echo "$CACHE_DIR/${1//:/_}.$CACHE_KEY.passed"
}

# ── Background-gate runner ────────────────────────────────────────────
declare -a BG_PIDS=()
declare -a BG_NAMES=()
declare -a BG_LOGS=()
declare -a BG_CACHEABLE=()

bg_gate() {
    local name="$1"; shift
    local cacheable="$1"; shift
    if [ "$cacheable" = "yes" ] && [ -n "$CACHE_KEY" ] && [ -f "$(cache_marker "$name")" ]; then
        log "  ⚡ $name cache HIT — skipping (last-passed for tree $CACHE_KEY)"
        return 0
    fi
    local logfile
    logfile=$(mktemp)
    ( "$@" > "$logfile" 2>&1 ) &
    BG_PIDS+=($!)
    BG_NAMES+=("$name")
    BG_LOGS+=("$logfile")
    BG_CACHEABLE+=("$cacheable")
}

wait_all() {
    local i
    for i in "${!BG_PIDS[@]}"; do
        if ! wait "${BG_PIDS[$i]}"; then
            FAIL_COUNT=$((FAIL_COUNT + 1))
            FAIL_NAMES="$FAIL_NAMES ${BG_NAMES[$i]}"
            log "  ❌ ${BG_NAMES[$i]} FAILED"
        else
            log "  ✅ ${BG_NAMES[$i]} passed"
            if [ "${BG_CACHEABLE[$i]}" = "yes" ] && [ -n "$CACHE_KEY" ]; then
                touch "$(cache_marker "${BG_NAMES[$i]}")"
            fi
        fi
        cat "${BG_LOGS[$i]}" >> "$LOG_FILE"
        rm -f "${BG_LOGS[$i]}"
    done
    BG_PIDS=(); BG_NAMES=(); BG_LOGS=(); BG_CACHEABLE=()
    if [ "$FAIL_COUNT" -gt 0 ]; then
        log "❌ FAILED GATES:$FAIL_NAMES"
        exit 1
    fi
}

log ""
log "🛑  PIPELINE QUALITY GATE"
log "══════════════════════════════════════════════════════"

# ── Phase 1: Prettier ─────────────────────────────────────────────────
log "📝 Phase 1: Prettier format..."
STAGED_SRC=$(git diff --cached --name-only --diff-filter=d -- 'src/')
if [ -n "$STAGED_SRC" ]; then
    # Batch the paths: `npx` is a .cmd shim on Windows, so one xargs call over
    # ~140+ staged files exceeds cmd.exe's 8191-char limit ("The command line
    # is too long"). `-n 40` keeps every invocation far below it.
    echo "$STAGED_SRC" | xargs -n 40 npx prettier --write --log-level warn 2>&1 | tee -a "$LOG_FILE"
    echo "$STAGED_SRC" | xargs -n 40 git add
fi

# Compute cache key from the tree AFTER Phase 1 fixed up whitespace.
CACHE_KEY=$(git write-tree 2>/dev/null)
if [ -n "$CACHE_KEY" ]; then
    log "🔑 cache key: $CACHE_KEY"
fi

# Guard: CACHE_KEY reflects the STAGED tree (`git write-tree`), but
# gates run against the WORKING tree. When unstaged changes exist in
# directories the gates inspect (src/, .github/, .husky/, etc.), the
# working tree diverges from the index — a cache HIT would then skip
# a gate that should run against different content than the key
# represents. Clear CACHE_KEY when unstaged changes exist to force
# fresh runs for the whole ladder (per CodeRabbit PR #215 review).
if [ -n "$CACHE_KEY" ] && ! git diff --quiet 2>/dev/null; then
    log "⚠️  unstaged changes detected — cache disabled for this run"
    CACHE_KEY=""
fi

# Trim cache: keep only markers for the current key — older entries are
# stale (they reference content that's no longer on disk anywhere).
if [ -n "$CACHE_KEY" ]; then
    find "$CACHE_DIR" -type f -name "*.passed" ! -name "*.$CACHE_KEY.passed" -delete 2>/dev/null
fi

# ── Phase 2: every gate in parallel ───────────────────────────────────
log ""
log "⚡ Phase 2: All gates parallel..."

# Whole program, but the TypeScript 7 native compiler checks it in seconds,
# and a type error is the commonest way a change breaks the build.
bg_gate "tsc" "yes" npm run type-check

# Staged files only, as CI's ESLint step scopes them (`src`, no `.cjs`).
# Not cached: the staged file list depends on HEAD as well as on the staged
# tree, so a cached pass could skip files this run would lint.
# Above 50 files the list would outgrow the Windows command line, so the
# gate lints the whole tree instead, exactly as CI does. A lint-config edit
# (`eslint.config.mjs`, `eslint/`, `biome.json`) can change the verdict on
# files nobody staged; only CI's full run sees that.
LINT_FILES=$(git diff --cached --name-only --diff-filter=d -- 'src/' | grep -E '\.(ts|tsx|js|jsx|mjs)$' || true)
if [ -n "$LINT_FILES" ]; then
    LINT_FILE_COUNT=$(echo "$LINT_FILES" | wc -l)
    if [ "$LINT_FILE_COUNT" -gt 50 ]; then
        log "  ℹ️  eslint/biome: $LINT_FILE_COUNT files staged — linting the whole src tree (cmdline-safe)"
        bg_gate "eslint" "no" npx eslint src --max-warnings 0 --ignore-pattern '**/*.cjs'
        bg_gate "biome" "no" npx biome lint src --max-diagnostics=50
    else
        LINT_LIST=$(mktemp)
        echo "$LINT_FILES" > "$LINT_LIST"
        # Read the list from stdin, NOT `xargs -a` — `-a` is a GNU extension
        # and macOS ships BSD xargs, where it aborts with "illegal option -- a".
        # NUL-separated, so a path with a space stays one argument.
        bg_gate "eslint" "no" bash -c "tr '\\n' '\\0' < '$LINT_LIST' | xargs -0 npx eslint --max-warnings 0"
        bg_gate "biome" "no" bash -c "tr '\\n' '\\0' < '$LINT_LIST' | xargs -0 npx biome lint --max-diagnostics=50 --no-errors-on-unmatched"
    fi
else
    log "  ⏭️  eslint/biome skipped — no lintable src/ file staged"
fi
if echo "$STAGED_FILES" | grep -q -E '^(eslint\.config\.mjs|eslint/|biome\.json)'; then
    log "  ℹ️  lint config staged — CI runs the full ESLint, guardrail and canary gates"
fi

# Architectural Guardrails — the linter's scope is the whole `src` tree
# (widened from Pipeline-only), matching `npm run lint`. Filter to `src/`
# so we don't hand it scripts/ or config files, and so we don't blow the
# Windows CreateProcess 32 KB command-line limit on a large staged set.
ARCH_FILES=$(echo "$CODE_FILES" | grep -E '^src/' || true)
if [ -n "$ARCH_FILES" ]; then
    ARCH_FILE_COUNT=$(echo "$ARCH_FILES" | wc -l)
    if [ "$ARCH_FILE_COUNT" -gt 50 ]; then
        log "  ℹ️  architecture: $ARCH_FILE_COUNT files staged — invoking on whole src directory (cmdline-safe)"
        bg_gate "architecture" "no" bash -c "npx tsx src/Tests/Tools/lint-and-validate.ts src"
    else
        ARCH_LIST=$(mktemp)
        echo "$ARCH_FILES" > "$ARCH_LIST"
        bg_gate "architecture" "no" bash -c "xargs npx tsx src/Tests/Tools/lint-and-validate.ts < '$ARCH_LIST'"
    fi
else
    log "  ⏭️  architecture skipped — no src/ files staged"
fi

# An import you just added is the usual way a cycle appears; the scan of the
# whole graph takes about two seconds.
bg_gate "cycles" "yes" npm run lint:cycles

# Leaks cannot be taken back once pushed, so these stay local as well as in
# CI. BASE_SHA is cleared so a value left exported in the shell cannot turn
# a staged scan into a branch-wide one. plan-refs is not cached: the staged
# additions depend on HEAD as well as on the staged tree.
bg_gate "fixtures-pii" "yes" npm run lint:fixtures-pii
bg_gate "pii-staged" "yes" env BASE_SHA= npm run lint:pii-staged
bg_gate "plan-refs" "no" env BASE_SHA= npm run lint:plan-refs

wait_all

log "══════════════════════════════════════════════════════"
log "✅  ALL LOCAL GATES PASSED. COMMITTING..."
log "   CI runs the full gate set on the pull request."
