{
  "name": "@sergienko4/israeli-bank-scrapers",
  "version": "9.0.0",
  "description": "Scrape transactions from Israeli banks and card providers over pure HTTP, with no browser",
  "engines": {
    "node": ">= 24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "src/**/graphql/*Queries.ts",
    "lib/index.cjs",
    "lib/index.mjs"
  ],
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "scripts": {
    "clean": "rimraf lib",
    "test": "node --experimental-vm-modules --expose-gc node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules --expose-gc node_modules/jest/bin/jest.js --config=jest.unit.config.js",
    "test:memory": "node --experimental-vm-modules --expose-gc node_modules/jest/bin/jest.js --config=jest.pipeline.config.cjs --testPathPatterns=TimerLeakInvariants --testPathPatterns=RaceTimeoutCancellation",
    "test:pipeline": "node --experimental-vm-modules --expose-gc node_modules/jest/bin/jest.js --config=jest.pipeline.config.cjs --ci --coverage --maxWorkers=2 --testPathIgnorePatterns=E2eReal/ --testPathIgnorePatterns=E2eMocked/ --testPathIgnorePatterns=E2eFull/ --testPathIgnorePatterns=E2e.test",
    "test:e2e:mock": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=E2eReal --testPathPatterns=E2eMocked --maxWorkers=2",
    "test:e2e:full": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=/node_modules/ --testPathPatterns=E2eFull --forceExit",
    "test:e2e:real": "npx tsx scripts/run-real-suite.ts",
    "test:e2e:real:single": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=E2eMocked --testPathPatterns=E2eReal",
    "test:mock": "cross-env MOCK_MODE=1 npx tsx scripts/run-mock-suite.ts",
    "test:e2e-factory-tests": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --testPathPatterns='Tests/E2e\\.test' --verbose --forceExit --maxWorkers=2",
    "test:full": "npm run test:mock && npm run test:unit",
    "measure:token-lifetime": "npx tsx src/Tests/E2eReal/Tools/MeasureTokenLifetime.ts",
    "test:gate": "npm run test:mock && npm run test:unit",
    "log:view": "npx tsx scripts/log-view.ts",
    "test:ci": "ncp src/Tests/.tests-config.tpl.cjs src/Tests/.tests-config.cjs && node --experimental-vm-modules --expose-gc node_modules/jest/bin/jest.js --ci --coverage",
    "validate:all": "npm run type-check && npm run test:unit && npm run test:e2e:mock && npm run lint",
    "check-exports": "publint",
    "api:update": "node scripts/check-public-surface.mjs --update",
    "lint": "eslint src --max-warnings 0 && npm run lint:syntax-guardrails && npm run lint:architecture src && npm run lint:retired-shims && bash src/Scrapers/Pipeline/EslintCanaries/verify.sh && npm run format:check",
    "lint:biome": "biome lint src --max-diagnostics=50",
    "lint:canaries": "bash src/Scrapers/Pipeline/EslintCanaries/verify.sh",
    "lint:dead-code": "npx tsx src/Tests/Tools/detect-dead-code.ts",
    "lint:cycles": "npx tsx src/Tests/Tools/lint-import-cycles.ts",
    "lint:guideline-coverage": "npx tsx src/Tests/Tools/lint-guideline-coverage.ts",
    "lint:test-duplication": "npx tsx src/Tests/Tools/lint-test-duplication.ts",
    "lint:fixtures-pii": "node scripts/audit-fixtures-pii.cjs",
    "lint:pii-staged": "node scripts/check-staged-pii.cjs",
    "lint:plan-refs": "node scripts/check-plan-refs.mjs",
    "lint:docs-strict": "python -m mkdocs build --strict --site-dir .mkdocs-strict-out",
    "lint:pr-body": "node scripts/validate-pr-body.mjs",
    "lint:doc-paths": "node scripts/check-doc-paths.mjs README.md CLAUDE.md CLEAN_CODE.md CONTRIBUTING.md .github/copilot-instructions.md",
    "lint:node-support": "node scripts/check-node-support.mjs",
    "lint:coderabbit-filters": "node scripts/check-coderabbit-filters.mjs",
    "lint:jest-scopes": "node scripts/check-jest-scopes.mjs",
    "lint:shell-tests": "bash .github/scripts/ci/tests/extract-exports.test.sh && bash .github/scripts/ci/tests/portable-map.test.sh",
    "lint:shell-portability": "node scripts/check-shell-portability.mjs",
    "lint:public-surface": "node scripts/check-public-surface.mjs --check",
    "lint:syntax-guardrails": "node scripts/check-syntax-guardrails.mjs",
    "compat:build": "node scripts/build-compatibility.mjs",
    "compat:check": "node scripts/build-compatibility.mjs --check",
    "lint:fix": "eslint src  --ignore-pattern '**/*.cjs' && npm run format",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "type-check:ts6": "node node_modules/typescript/bin/tsc --noEmit",
    "dev": "npm run type-check -- --watch",
    "build": "npm run lint && tsup",
    "postbuild": "rimraf lib/Common lib/Scrapers lib/Tests",
    "prepare:default": "git reset --hard && npm ci && npm run build",
    "prepare": "tsup && rimraf lib/Common lib/Scrapers lib/Tests",
    "reset": "git reset --hard && npm ci",
    "docs": "typedoc",
    "lint:architecture": "npx tsx src/Tests/Tools/lint-and-validate.ts",
    "lint:retired-shims": "npx tsx src/Tests/Tools/lint-and-validate.ts --only \"Rule #17\" src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergienko4/israeli-bank-scrapers.git"
  },
  "keywords": [
    "israel",
    "israeli banks",
    "bank scraper",
    "scraper",
    "web-scraping",
    "typescript",
    "fintech",
    "financial-automation"
  ],
  "author": "Sergienko",
  "license": "PolyForm-Noncommercial-1.0.0",
  "bugs": {
    "url": "https://github.com/sergienko4/israeli-bank-scrapers/issues"
  },
  "homepage": "https://github.com/sergienko4/israeli-bank-scrapers#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/source-map-support": "^0.5.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^65.4.4",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^14.0.4",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "ncp": "^2.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "publint": "^0.3.21",
    "rimraf": "^6.1.4",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "tsup": "^9.0.0",
    "tsx": "^4.22.1",
    "typedoc": "^0.28.17",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.59.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "parse5": "^7.3.0",
    "pino": "^10.3.1"
  },
  "files": [
    "lib/**/*",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "overrides": {
    "test-exclude": "^7.0.2",
    "esbuild": "^0.28.1",
    "glob": "$glob",
    "minimatch": "^11.0.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}
