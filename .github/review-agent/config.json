{
  "provider": "opencode-go",
  "modelPrefix": "deepseek",
  "defaultVariant": "high",
  "variantPriority": ["high", "max", "low"],
  "fallbackModels": [
    {
      "id": "deepseek-v4.1-flash",
      "variants": ["low", "high", "max"]
    },
    {
      "id": "deepseek-v4-pro",
      "variants": ["high", "max"]
    }
  ],
  "defaultReviewEvent": "COMMENT",
  "blockingSeverities": ["critical", "important"],
  "maxInlineComments": 10,
  "maxFindings": 30,
  "maxFiles": 300,
  "maxDiffChars": 120000,
  "maxFileChars": 60000,
  "approval": {
    "enabled": true,
    "allowAuthor": true
  },
  "appLogin": "review-agent[bot]"
}
