{
  "provider": "opencode-go",
  "modelPrefix": "deepseek",
  "defaultModel": "auto",
  "defaultVariant": "high",
  "variantPriority": ["high", "max", "low"],
  "fallbackModels": [
    {
      "id": "deepseek-v4.1-flash",
      "variants": ["low", "high", "max"]
    },
    {
      "id": "deepseek-v4-pro",
      "variants": ["high", "max"]
    }
  ],
  "reviewEvent": "COMMENT",
  "marker": "<!-- opencode-review-agent -->",
  "maxInlineComments": 10,
  "maxFindings": 30,
  "maxDiffChars": 120000,
  "maxFileChars": 60000,
  "timeoutMinutes": 20,
  "maxSteps": 30,
  "summarySections": ["verdict", "context", "what-was-read", "not-executed", "guidelines-read"]
}
